# Server Configuration
PORT=8080
ALLOW_ORIGINS=http://localhost:4200

# OIDC Authentication Configuration
# Set DISABLE_AUTH=true to disable authentication (for development/testing)
DISABLE_AUTH=false

# OIDC Provider Settings
# Example for Keycloak: http://localhost:8080/realms/your-realm
OIDC_ISSUER_URL=http://localhost:8080/realms/scicat
OIDC_CLIENT_ID=depositor
OIDC_CLIENT_SECRET=your-client-secret-here
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback

# Session Settings
SESSION_DURATION=3600
SECURE_COOKIES=false

# Frontend and Backend URLs
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:8080
